# Hub endpoint reachable from the NAS.
TOKEN_MONITOR_HUB_URL=http://TOKEN_MONITOR_HUB_HOST:17321

# Generate a long random value. Never commit the real secret.
TOKEN_MONITOR_SECRET=replace-with-a-random-secret

# Hub only: opt in to the Windows scheduled, compressed stream at /windows.
# The ordinary /api endpoints stay realtime. Default is disabled.
TOKEN_MONITOR_WINDOWS_STREAM_ENABLED=0
