# Hub endpoint reachable from the NAS.
TOKEN_MONITOR_HUB_URL=http://TOKEN_MONITOR_HUB_HOST:17321
# Optional Node Hub display name (private stats/SSE only). Does not rename an Agent or change its ID.
# Set this on the Hub service; Agent-only services do not need it.
# Example after explicit configuration: TOKEN_MONITOR_HUB_DISPLAY_NAME=DXP4800
TOKEN_MONITOR_HUB_DISPLAY_NAME=

# Generate a long random value. Never commit the real secret.
TOKEN_MONITOR_SECRET=replace-with-a-random-secret

# Hub only: opt in to the Windows scheduled, compressed stream at /windows.
# The ordinary /api endpoints stay realtime. Default is disabled.
TOKEN_MONITOR_WINDOWS_STREAM_ENABLED=0

# Optional Hub batch persistence in milliseconds; 0 preserves synchronous saves.
# Nonzero values can lose acknowledged but unsaved uploads on abrupt termination.
TOKEN_MONITOR_PERSIST_INTERVAL_MS=0
